# --- Supabase (required for auth + data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used ONLY by scripts/import-content.ts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pro gating. "off" = every feature open while payments are not live. "on" = enforce Free/Pro.
FEATURE_GATING=off
