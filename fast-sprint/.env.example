# Public Supabase project settings (publishable/anon key, never service role here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Server only: content scripts and trusted billing operations
SUPABASE_SERVICE_ROLE_KEY=
# Disabled until billing.sql approval + provider test configuration + acceptance tests
PAYMENTS_ENABLED=false
RAZORPAY_MODE=test
# Staging only; also requires billing_environment.allow_test_pro=true in the approved DB.
RAZORPAY_TEST_PRO_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Keep false. Separate explicit approval required before enabling live payments.
RAZORPAY_LIVE_ENABLED=false
# Google client ID + secret belong in Supabase Auth > Providers > Google, not here.
# Local import tooling only: SUPABASE_DB_URL and SUPABASE_DB_CA_FILE (see deployment checklist).
# Keep false until preparation_tools.sql is approved/applied and hosted RLS checks pass.
PREPARATION_TOOLS_ENABLED=false

# Enable only after the assessment proposal is approved/applied and hosted tests pass.
ASSESSMENTS_ENABLED=false
